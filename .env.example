# .env.example – copy this file to .env and fill in your values
# Never commit the real .env file to Git.

# Path to the pre-processed exoplanet JSON dataset
EXOPLANET_DATA_PATH=./outputs/dashboard_data.json

# NASA API key (optional – needed only if you integrate additional NASA APIs)
# Get yours free at: https://api.nasa.gov/
# NASA_API_KEY=YOUR_API_KEY_HERE

# Port for the local development HTTP server
DEV_SERVER_PORT=8080
